#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <dirent.h>
#include <errno.h>
#include <time.h>

#define MAX_PATH 512
#define MAX_ENVIRONMENTS 32

void usage(const char *progname) {
    fprintf(stderr, "Usage:\n");
    fprintf(stderr, "  %s -c <ENVIRONMENT_NAME>\n", progname);
    fprintf(stderr, "  %s -c -v <ENVIRONMENT_NAME>\n", progname);
    fprintf(stderr, "  %s -v <ENVIRONMENT_NAME> [-v ...] -i <PACKAGE_NAME>==<VERSION>\n", progname);
    fprintf(stderr, "  %s -v <ENVIRONMENT_NAME> [-v ...] -r <PACKAGE_NAME>\n", progname);
    exit(EXIT_FAILURE);
}

int environment_exists(const char *env_name) {
    struct stat st;
    if (stat(env_name, &st) == 0 && S_ISDIR(st.st_mode)) {
        return 1;
    }
    return 0;
}

void create_environment(const char *env_name) {
    if (environment_exists(env_name)) {
        fprintf(stderr, "sop-venv: environment already exists\n");
        exit(EXIT_FAILURE);
    }

    if (mkdir(env_name, 0755) != 0) {
        perror("sop-venv: mkdir");
        exit(EXIT_FAILURE);
    }

    char req_path[MAX_PATH];
    snprintf(req_path, sizeof(req_path), "%s/requirements", env_name);

    FILE *f = fopen(req_path, "w");
    if (!f) {
        perror("sop-venv: fopen requirements");
        exit(EXIT_FAILURE);
    }
    fclose(f);
}

int is_package_installed(const char *env_name, const char *pkg_name) {
    char req_path[MAX_PATH];
    snprintf(req_path, sizeof(req_path), "%s/requirements", env_name);

    FILE *f = fopen(req_path, "r");
    if (!f) return 0;

    char line[MAX_PATH];
    while (fgets(line, sizeof(line), f) != NULL) {
        char name[MAX_PATH], ver[MAX_PATH];
        if (sscanf(line, "%s %s", name, ver) >= 1) {
            if (strcmp(name, pkg_name) == 0) {
                fclose(f);
                return 1;
            }
        }
    }
    fclose(f);
    return 0;
}

void install_package(const char *env_name, const char *pkg_name, const char *version) {
    if (!environment_exists(env_name)) {
        fprintf(stderr, "sop-venv: the environment does not exist\n");
        usage("sop-venv");
    }

    if (is_package_installed(env_name, pkg_name)) {
        fprintf(stderr, "sop-venv: package '%s' is already installed\n", pkg_name);
        exit(EXIT_FAILURE);
    }

    char req_path[MAX_PATH];
    snprintf(req_path, sizeof(req_path), "%s/requirements", env_name);

    FILE *f = fopen(req_path, "a");
    if (!f) {
        perror("sop-venv: fopen requirements");
        exit(EXIT_FAILURE);
    }
    fprintf(f, "%s %s\n", pkg_name, version);
    fclose(f);

    char pkg_path[MAX_PATH];
    snprintf(pkg_path, sizeof(pkg_path), "%s/%s", env_name, pkg_name);

    FILE *pkg_f = fopen(pkg_path, "w");
    if (!pkg_f) {
        perror("sop-venv: fopen package file");
        exit(EXIT_FAILURE);
    }
    // Wypełnienie pliku losowymi znakami
    for (int i = 0; i < 30; i++) {
        fputc('A' + (rand() % 26), pkg_f);
    }
    fputc('\n', pkg_f);
    fclose(pkg_f);

    // Ustawienie uprawnień tylko do odczytu dla wszystkich (-r--r--r--, 0444)
    if (chmod(pkg_path, S_IRUSR | S_IRGRP | S_IROTH) != 0) {
        perror("sop-venv: chmod");
        exit(EXIT_FAILURE);
    }
}

void remove_package(const char *env_name, const char *pkg_name) {
    if (!environment_exists(env_name)) {
        fprintf(stderr, "sop-venv: the environment does not exist\n");
        usage("sop-venv");
    }

    if (!is_package_installed(env_name, pkg_name)) {
        fprintf(stderr, "sop-venv: package '%s' is not installed\n", pkg_name);
        exit(EXIT_FAILURE);
    }

    char req_path[MAX_PATH];
    snprintf(req_path, sizeof(req_path), "%s/requirements", env_name);

    FILE *f = fopen(req_path, "r");
    if (!f) {
        perror("sop-venv: fopen requirements");
        exit(EXIT_FAILURE);
    }

    char temp_path[MAX_PATH];
    snprintf(temp_path, sizeof(temp_path), "%s/requirements.tmp", env_name);
    FILE *temp_f = fopen(temp_path, "w");
    if (!temp_f) {
        perror("sop-venv: fopen temp requirements");
        fclose(f);
        exit(EXIT_FAILURE);
    }

    char line[MAX_PATH];
    while (fgets(line, sizeof(line), f) != NULL) {
        char name[MAX_PATH], ver[MAX_PATH];
        if (sscanf(line, "%s %s", name, ver) >= 1) {
            if (strcmp(name, pkg_name) == 0) {
                continue; // Pomijamy usunięty pakiet
            }
        }
        fputs(line, temp_f);
    }

    fclose(f);
    fclose(temp_f);

    if (rename(temp_path, req_path) != 0) {
        perror("sop-venv: rename requirements");
        exit(EXIT_FAILURE);
    }

    char pkg_path[MAX_PATH];
    snprintf(pkg_path, sizeof(pkg_path), "%s/%s", env_name, pkg_name);
    if (unlink(pkg_path) != 0) {
        perror("sop-venv: unlink package file");
    }
}

int main(int argc, char *argv[]) {
    int opt;
    int create_flag = 0;
    char *environments[MAX_ENVIRONMENTS];
    int env_count = 0;
    char *install_arg = NULL;
    char *remove_arg = NULL;

    srand(time(NULL));

    while ((opt = getopt(argc, argv, "cv:i:r:")) != -1) {
        switch (opt) {
            case 'c':
                create_flag = 1;
                break;
            case 'v':
                if (env_count < MAX_ENVIRONMENTS) {
                    environments[env_count++] = optarg;
                } else {
                    fprintf(stderr, "sop-venv: too many environments specified\n");
                    exit(EXIT_FAILURE);
                }
                break;
            case 'i':
                install_arg = optarg;
                break;
            case 'r':
                remove_arg = optarg;
                break;
            default:
                usage(argv[0]);
        }
    }

    // Obsługa tworzenia środowiska (-c)
    if (create_flag) {
        char *env_to_create = NULL;
        if (env_count == 1) {
            env_to_create = environments[0];
        } else if (optind < argc) {
            env_to_create = argv[optind];
        }

        if (!env_to_create) {
            fprintf(stderr, "sop-venv: missing environment name for creation\n");
            usage(argv[0]);
        }

        create_environment(env_to_create);
        return EXIT_SUCCESS;
    }

    // Obsługa instalacji (-i)
    if (install_arg) {
        if (env_count == 0) {
            fprintf(stderr, "sop-venv: no environment specified\n");
            usage(argv[0]);
        }

        char *eq = strstr(install_arg, "==");
        if (!eq) {
            fprintf(stderr, "sop-venv: invalid package format. Expected PACKAGE_NAME==VERSION\n");
            exit(EXIT_FAILURE);
        }
        *eq = '\0';
        char *pkg_name = install_arg;
        char *version = eq + 2;

        if (strlen(pkg_name) == 0 || strlen(version) == 0) {
            fprintf(stderr, "sop-venv: invalid package name or version\n");
            exit(EXIT_FAILURE);
        }

        for (int i = 0; i < env_count; i++) {
            install_package(environments[i], pkg_name, version);
        }

        return EXIT_SUCCESS;
    }

    // Obsługa deinstalacji (-r)
    if (remove_arg) {
        if (env_count == 0) {
            fprintf(stderr, "sop-venv: no environment specified\n");
            usage(argv[0]);
        }

        char *pkg_name = remove_arg;
        if (strlen(pkg_name) == 0) {
            fprintf(stderr, "sop-venv: invalid package name\n");
            exit(EXIT_FAILURE);
        }

        for (int i = 0; i < env_count; i++) {
            remove_package(environments[i], pkg_name);
        }

        return EXIT_SUCCESS;
    }

    usage(argv[0]);
    return EXIT_SUCCESS;
}
